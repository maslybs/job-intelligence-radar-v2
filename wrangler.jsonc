{
  "name": "job-intelligence-radar-starter",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "job-intelligence-radar-starter-db",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    {
      "binding": "REDDIT_MCP_WORKFLOW",
      "name": "job-radar-starter-reddit",
      "class_name": "RedditMcpWorkflow"
    },
    {
      "binding": "MANUAL_RADAR_WORKFLOW",
      "name": "job-radar-starter-manual",
      "class_name": "ManualRadarWorkflow"
    },
    {
      "binding": "DOU_BROWSER_WORKFLOW",
      "name": "job-radar-starter-dou",
      "class_name": "DouBrowserWorkflow"
    }
  ],
  "vars": {
    "REDDIT_MCP_ENABLED": "0",
    "DOU_BROWSER_ENABLED": "0"
  }
}
